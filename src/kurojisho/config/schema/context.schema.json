{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kurojisho.context.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "tier": {"type": "integer", "minimum": 1, "maximum": 4},
          "data_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["PII", "PCI", "PHI", "secrets", "IP"]}
          },
          "exposure": {"enum": ["internet", "partner", "internal", "none"]},
          "asvs_level": {"enum": [2, 3]},
          "regulatory": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asvs_level": {"enum": [2, 3]},
        "tier": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm_features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "tools_allowed": {"type": "array", "items": {"type": "string"}},
              "human_approval_required": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
